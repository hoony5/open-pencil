{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "openpencil-roundtrip/exp6/manifest.schema.json",
  "title": "html2snippet roundtrip manifest",
  "description": "HTML 경로 ↔ fig id ↔ 스니펫/위젯 경로 3열 매핑. 양쪽 산출물의 구조 동치 게이트 결과를 포함한다. 모든 경로는 openpencil-roundtrip 루트 기준 상대 경로.",
  "type": "object",
  "required": ["version", "entries", "pass"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "generator": { "type": "string" },
    "pass": { "type": "boolean", "description": "전 항목 게이트 통과 여부" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "html", "fig", "snippet", "checks"],
        "properties": {
          "id": { "type": "string", "description": "페이지 식별자" },
          "html": { "type": "string", "description": "컬럼 1 — 소스 HTML 경로" },
          "fig": {
            "type": "object",
            "description": "컬럼 2 — fig 산출물과 루트 노드 id",
            "required": ["file", "rootId", "rootName"],
            "properties": {
              "file": { "type": "string" },
              "rootId": { "type": "string", "description": ".fig 내부 루트 프레임 노드 id" },
              "rootName": { "type": "string" },
              "layerCount": { "type": "integer" }
            }
          },
          "snippet": {
            "type": "object",
            "description": "컬럼 3 — 스니펫 md와 조립 위젯 경로",
            "required": ["md", "dart", "className", "rootName", "components"],
            "properties": {
              "md": { "type": "string" },
              "dart": { "type": "string", "description": "컴파일 게이트 조립 파일" },
              "className": { "type": "string" },
              "rootName": { "type": "string" },
              "components": { "type": "array", "items": { "type": "string" } },
              "tokenCount": { "type": "integer" }
            }
          },
          "checks": {
            "type": "object",
            "description": "구조 동치 게이트 결과",
            "required": ["fileExistence", "rootNameEquivalence", "componentSubset"],
            "properties": {
              "fileExistence": { "type": "boolean" },
              "rootNameEquivalence": { "type": "boolean", "description": "md 루트명 == fig 루트 레이어명" },
              "componentSubset": { "type": "boolean", "description": "스니펫 컴포넌트명 ⊆ fig 레이어명 (Dart 식별자 정규화 적용: 비영숫자→_)" },
              "missingComponents": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
